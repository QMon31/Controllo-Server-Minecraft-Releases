<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#7cb342</item>
        <item name="android:colorPrimaryDark">#171719</item>
        <item name="android:colorAccent">#9ccc65</item>
        <item name="android:windowBackground">#171719</item>
        <item name="android:statusBarColor">#171719</item>
        <item name="android:navigationBarColor">#171719</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:textColor">#f4f4f5</item>
        <item name="android:textColorHint">#8a8c92</item>
        <item name="android:buttonStyle">@style/AppButton</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <!-- Pulsanti: testo come scritto (niente maiuscole automatiche) -->
    <style name="AppButton" parent="@android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Finestre di dialogo nel tema Data terminal: fondo rialzato, pulsanti verdi senza maiuscole -->
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#9ccc65</item>
        <item name="android:textColorPrimary">#f4f4f5</item>
        <item name="android:textColor">#f4f4f5</item>
        <item name="android:textColorSecondary">#c4c4c8</item>
        <item name="android:textColorHint">#8a8c92</item>
        <item name="android:buttonBarButtonStyle">@style/AppDialogButton</item>
    </style>

    <style name="AppDialogButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#9ccc65</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
