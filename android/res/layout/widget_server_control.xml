<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- TOP HEADER ROW -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_launcher"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/widget_icon"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:text="Server Minecraft"
            android:textColor="#f4f4f5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Online"
            android:textColor="#a5d36f"
            android:textSize="11sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- MIDDLE INFO ROW: PLAYERS & RAM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="2">

        <TextView
            android:id="@+id/widget_players"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giocatori: --"
            android:textColor="#c4c4c8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_ram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="RAM: -- GB"
            android:textColor="#9ccc65"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:weightSum="3">

        <Button
            android:id="@+id/widget_btn_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Avvia"
            android:textSize="11sp"
            android:textColor="#131217"
            android:textStyle="bold"
            android:background="@drawable/btn_green"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/widget_btn_restart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Riavvia"
            android:textSize="11sp"
            android:textColor="#f4f4f5"
            android:textStyle="bold"
            android:background="@drawable/btn_blue"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/widget_btn_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Ferma"
            android:textSize="11sp"
            android:textColor="#f4f4f5"
            android:textStyle="bold"
            android:background="@drawable/btn_red" />
    </LinearLayout>
</LinearLayout>
