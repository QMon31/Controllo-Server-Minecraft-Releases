<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
        <solid android:color="#2a2a2e" />
        <stroke android:width="1dp" android:color="#4a4a4f" />
    </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="oval">
        <solid android:color="#171719" />
        <stroke android:width="1dp" android:color="#242327" />
    </shape>
    </item>
    <item>
        <shape android:shape="oval">
        <solid android:color="#212023" />
        <stroke android:width="1dp" android:color="#3a3a3e" />
    </shape>
    </item>
</selector>
