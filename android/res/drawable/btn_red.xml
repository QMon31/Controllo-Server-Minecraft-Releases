<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
        <solid android:color="#3a2028" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#e5566f" />
    </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
        <solid android:color="#171719" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#242327" />
    </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
        <solid android:color="#2c1a20" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#7a3442" />
    </shape>
    </item>
</selector>
