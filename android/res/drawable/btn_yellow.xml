<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
        <solid android:color="#352d1b" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#d9a441" />
    </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
        <solid android:color="#171719" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#242327" />
    </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
        <solid android:color="#2a2416" />
        <corners android:radius="6dp" />
        <stroke android:width="1dp" android:color="#6e5a2c" />
    </shape>
    </item>
</selector>
