    <item>
        <shape android:shape="rectangle">
            <solid android:color="#212023" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#7cb342" />
        </shape>
    </item>
</layer-list>
